# The backend's admin-only GraphQL endpoint. The Google sign-in endpoint
# (/admin-auth/google/) is worked out from it.
NEXT_PUBLIC_ADMIN_GRAPHQL_URL=http://localhost:8000/admin-graphql/

# Optional: a different Google OAuth client (e.g. a staging project). Defaults
# to the main website's client, which the backend already accepts.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
